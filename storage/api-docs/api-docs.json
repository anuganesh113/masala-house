{
    "openapi": "3.0.0",
    "info": {
        "title": "Masala House API",
        "version": "1.0.0"
    },
    "paths": {
        "/api/pages": {
            "get": {
                "tags": [
                    "Pages"
                ],
                "summary": "List pages",
                "description": "Returns active parent pages with their active child pages.",
                "operationId": "getPages",
                "responses": {
                    "200": {
                        "description": "Pages returned."
                    }
                }
            }
        },
        "/api/pages/{page}": {
            "get": {
                "tags": [
                    "Pages"
                ],
                "summary": "Show page",
                "description": "Returns an active page by ID or slug.",
                "operationId": "getPage",
                "parameters": [
                    {
                        "name": "page",
                        "in": "path",
                        "description": "Page ID or slug",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "about-us"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Page returned."
                    },
                    "404": {
                        "description": "Page not found."
                    }
                }
            }
        },
        "/api/masala-house": {
            "get": {
                "tags": [
                    "Masala House"
                ],
                "summary": "Get masala house",
                "description": "Returns the masala house.",
                "operationId": "getSetting",
                "responses": {
                    "200": {
                        "description": "Masala house returned."
                    },
                    "401": {
                        "description": "Masala house not found."
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Pages",
            "description": "Pages"
        },
        {
            "name": "Masala House",
            "description": "Masala House"
        }
    ]
}